FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    ZES_ENABLE_SYSMAN=0 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    wget \
    git \
    python3 \
    python3-pip \
    ocl-icd-libopencl1 \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Install Intel Compute Runtime 26.35, GmmLib 22.10, IGC 2.41.5, and Level Zero Loader 1.34 for Battlemage (Xe2)
# Note 1: IGC v2.41.5 carries the '+22716' build suffix on GitHub
# Note 2: Stock Ubuntu 24.04 libze1 (1.16.1) lacks zeInitDrivers; 1.34+ is required
ARG COMPUTE_RUNTIME_VERSION=26.35.39758.10
ARG GMMLIB_VERSION=22.10.0
ARG IGC_VERSION=2.41.5
ARG IGC_BUILD=22716
ARG LEVEL_ZERO_VERSION=1.34.0

RUN set -eux; \
    mkdir -p /tmp/neo && cd /tmp/neo && \
    CR="https://github.com/intel/compute-runtime/releases/download/${COMPUTE_RUNTIME_VERSION}" && \
    IGC="https://github.com/intel/intel-graphics-compiler/releases/download/v${IGC_VERSION}" && \
    ZE="https://github.com/oneapi-src/level-zero/releases/download/v${LEVEL_ZERO_VERSION}" && \
    curl -fsSL -O "${CR}/libigdgmm12_${GMMLIB_VERSION}_amd64.deb" && \
    curl -fsSL -O "${CR}/intel-ocloc_${COMPUTE_RUNTIME_VERSION}-0_amd64.deb" && \
    curl -fsSL -O "${CR}/intel-opencl-icd_${COMPUTE_RUNTIME_VERSION}-0_amd64.deb" && \
    curl -fsSL -O "${CR}/libze-intel-gpu1_${COMPUTE_RUNTIME_VERSION}-0_amd64.deb" && \
    curl -fsSL -O "${IGC}/intel-igc-core-2_${IGC_VERSION}+${IGC_BUILD}_amd64.deb" && \
    curl -fsSL -O "${IGC}/intel-igc-opencl-2_${IGC_VERSION}+${IGC_BUILD}_amd64.deb" && \
    curl -fsSL -O "${ZE}/libze1_${LEVEL_ZERO_VERSION}+u24.04_amd64.deb" && \
    curl -fsSL -O "${ZE}/libze-dev_${LEVEL_ZERO_VERSION}+u24.04_amd64.deb" && \
    apt-get update && \
    apt-get install -y --no-install-recommends ./*.deb && \
    cd / && rm -rf /tmp/neo /var/lib/apt/lists/*

# Install official PyTorch with native Intel Arc XPU backend
RUN pip3 install --no-cache-dir --break-system-packages \
    torch torchvision --index-url https://download.pytorch.org/whl/xpu

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

WORKDIR /workspace

ENTRYPOINT ["/entrypoint.sh"]
CMD ["tail", "-f", "/dev/null"]
